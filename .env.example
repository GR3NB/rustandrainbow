# Rust & Rainbow — API Keys
# Copy this file to .env and fill in your actual keys
# NEVER share .env or commit it anywhere

# --- IDEOGRAM ---
# Get from: ideogram.ai → Settings → API
IDEOGRAM_API_KEY=your_key_here

# --- PRINTIFY ---
# Get from: printify.com → Settings → API
PRINTIFY_API_KEY=your_key_here
PRINTIFY_SHOP_ID=your_shop_id_here

# --- META (Instagram + Facebook) ---
# Long-lived token from: developers.facebook.com → Your App → Tools → Access Token Debugger
# Expires every ~60 days — refresh before expiry date in LESSONS_LEARNED.md
META_ACCESS_TOKEN=your_long_lived_token_here
META_FB_PAGE_ID=your_fb_page_id_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_ig_account_id_here

# --- ZERNIO (TikTok + Pinterest) ---
# TikTok and Pinterest direct APIs reject solo-operator posting — use Zernio instead.
# Get API key from: zernio.com → Settings → API Keys
# Get account IDs from: zernio.com → Connected Accounts (after connecting TikTok + Pinterest)
# Get Pinterest board ID from the board URL slug: pinterest.com/rustandrainbow/{board-slug}/
ZERNIO_API_KEY=your_key_here
ZERNIO_TIKTOK_ACCOUNT_ID=your_tiktok_account_id_here
ZERNIO_PINTEREST_ACCOUNT_ID=your_pinterest_account_id_here
PINTEREST_BOARD_ID=your_board_slug_here

# --- ANTHROPIC (Claude API — required for --mode report) ---
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=your_key_here

# --- ETSY (required for listing analytics + auto-optimisation in --mode report) ---
# Printify still publishes to Etsy natively — these keys add direct Etsy data access.
# Setup: run python3 etsy_auth.py after your Etsy developer app is approved.
# etsy_auth.py will write ETSY_ACCESS_TOKEN and ETSY_SHOP_ID to .env automatically.
# Get ETSY_API_KEY from: etsy.com/developers → Your Apps → API Key
ETSY_API_KEY=your_key_here
ETSY_ACCESS_TOKEN=your_access_token_here
ETSY_SHOP_ID=your_shop_id_here
